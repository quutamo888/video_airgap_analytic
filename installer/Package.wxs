<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Video Dead Air Cutter"
           Manufacturer="Woradorn"
           Version="1.0.0.0"
           UpgradeCode="d28362cb-500d-452d-8e47-e17f86745ad1"
           Scope="perUserOrMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="VideoDeadAirCutter" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Video Dead Air Cutter" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Files Include="..\dist\VideoDeadAirCutter\**" />
    </ComponentGroup>

    <ComponentGroup Id="ShortcutComponents" Directory="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="73b885da-0518-4720-9118-8686d141e976">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="Video Dead Air Cutter"
                  Description="Auto-trim dead air from videos"
                  Target="[INSTALLFOLDER]VideoDeadAirCutter.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <Shortcut Id="ApplicationDesktopShortcut"
                  Directory="DesktopFolder"
                  Name="Video Dead Air Cutter"
                  Description="Auto-trim dead air from videos"
                  Target="[INSTALLFOLDER]VideoDeadAirCutter.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="CleanUpShortCut" Directory="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\Woradorn\VideoDeadAirCutter" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="MainFeature" Title="Video Dead Air Cutter" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="ShortcutComponents" />
    </Feature>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
  </Package>
</Wix>
